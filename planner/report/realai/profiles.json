{
  "_schema": "BuildFi realai profile spec v2 — single source consumed by gen-real-mc.mjs AND build-realai-reports.js",
  "_fields": {
    "id": "string — profile key, used in output filenames",
    "lang": "'fr' | 'en' — narration language",
    "mode": "'standard' | 'expert' — report mode, affects sections shown",
    "sku": "'bilan' | 'planner' — SKU controls includeSimulator flag (Bilan gets embedded What-If, Planner does not)",
    "nSim": "integer — Monte Carlo simulation count (gen-real-mc.mjs)",
    "finLiteracy": "'beginner' | 'intermediate' | 'advanced' — AI calibration",
    "stressLevel": "'low' | 'moderate' | 'high' — AI tone",
    "detailPref": "'concise' | 'balanced' | 'detailed' — AI verbosity",
    "client": "object — name, firstName, spouseFirstName, email (for personalization)",
    "params": "object — ALL engine inputs (consumed by runMC); must be complete",
    "case_driver": "string — the SINGLE most case-defining lever for this profile. Enforced by action-auditor: lever #1 in the action plan MUST address this driver. Allowed values: ccpc_extraction, rental_cashflow, gis_trap, fire_bridge, db_pension_split, meltdown_window, debt_paydown, gap_savings, hnw_estate, late_start_savings, single_parent_resilience"
