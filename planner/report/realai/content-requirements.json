{
  "_schema": "BuildFi content-requirements registry v1 — consumed by review/reviewers/content-depth-auditor.js",
  "_doc": {
    "purpose": "Maps each profile case_driver to the content beats that MUST appear in the rendered report's visible text. The structural auditors (data, table, chart, etc.) confirm the section exists; this registry confirms the section actually discusses the case-defining mechanism.",
    "schema": {
      "required_beats": "array of beat specs",
      "beat": {
        "id": "stable identifier — finding.id derives from this",
        "label": "human-readable description for finding.message",
        "patterns": "array of regex strings (case-insensitive). Beat is PRESENT iff at least one pattern matches the visible text of the target section (or full report when section='*').",
        "section": "section ID where the beat must appear, OR '*' to mean any visible body text. If the section is not rendered at all, the beat is SKIPPED (no finding) — structural auditors handle missing-section cases.",
        "min_section": "anchor — currently advisory only. Reserved for future use ('any' = appears anywhere in section, 'narrative' = must appear inside an AI narration block)."
      }
    }
  },
  "drivers": {
    "ccpc_extraction": {
      "required_beats": [
        {
          "id": "cda_rdtoh_split",
          "label": "CDA / RDTOH split is named explicitly",
          "patterns": ["\\bCDA\\b", "\\bRDTOH\\b", "capital dividend account", "compte de dividendes en capital", "refundable dividend tax on hand", "imp[oô]t en main remboursable"],
          "section": "sec-corp",
          "min_section": "any"
        },
        {
          "id": "eligible_dividend_treatment",
          "label": "Eligible vs non-eligible dividend treatment is discussed",
          "patterns": ["eligible dividend", "non-eligible dividend", "dividende d[ée]termin[ée]", "dividende non d[ée]termin[ée]", "\\bGRIP\\b", "\\bLRIP\\b"],
          "section": "sec-corp",
          "min_section": "any"
        },
        {
          "id": "integration_rate_named",
          "label": "Corporate-personal integration rate is quantified",
          "patterns": ["integrated rate", "taux int[ée]gr[ée]", "tax integration", "int[ée]gration fiscale", "corporate.{0,15}personal"],
          "section": "sec-corp",
          "min_section": "any"
        },
        {
          "id": "lcge_named",
          "label": "Lifetime Capital Gains Exemption named",
          "patterns": ["\\bLCGE\\b", "lifetime capital gains exemption", "exon[ée]ration cumulative des gains", "\\bDDPE\\b"],
          "section": "sec-corp",
          "min_section": "any"
        },
        {
          "id": "extraction_order_explained",
          "label": "Extraction order (salary vs dividend vs sale) is mapped",
          "patterns": ["salary.{0,15}dividend", "dividend.{0,15}salary", "salaire.{0,15}dividende", "dividende.{0,15}salaire", "extraction order", "ordre d['’]extraction", "extraction strategy", "strat[ée]gie d['’]extraction"],
          "section": "sec-corp",
          "min_section": "any"
        }
      ]
    },
